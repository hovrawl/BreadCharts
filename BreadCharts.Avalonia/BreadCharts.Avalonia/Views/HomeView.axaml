<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:BreadCharts.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:MainViewModel"
             x:Class="BreadCharts.Avalonia.Views.HomeView">
    <StackPanel
>
        <!-- Show only when user is NOT logged in -->
        <Button Content="Sign In with Spotify" 
                IsVisible="{CompiledBinding CurrentUser, Converter={x:Static ObjectConverters.IsNull}}" />
        <!-- Show only when user IS logged in -->
        <TextBlock Text="{CompiledBinding CurrentUser.Name}" 
                   IsVisible="{CompiledBinding CurrentUser, Converter={x:Static ObjectConverters.IsNotNull}}" />

    </StackPanel>
</UserControl>
