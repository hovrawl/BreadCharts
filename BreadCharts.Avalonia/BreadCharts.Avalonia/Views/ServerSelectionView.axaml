<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BreadCharts.Avalonia.ViewModels"
             xmlns:services="using:BreadCharts.Avalonia.Services"
             x:Class="BreadCharts.Avalonia.Views.ServerSelectionView"
             x:DataType="vm:ServerSelectionViewModel">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
        <TextBlock Text="Select a Server" FontSize="24" HorizontalAlignment="Center"/>
        
        <ListBox ItemsSource="{Binding Servers}" 
                 SelectedItem="{Binding SelectedServer}"
                 Width="300" Height="200">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="services:ServerInfo">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding MachineName}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Address}" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Content="Connect" 
                Command="{Binding SelectServerCommand}" 
                HorizontalAlignment="Center">
            <Button.IsEnabled>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="SelectedServer" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                    <Binding Path="ManualAddress" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                </MultiBinding>
            </Button.IsEnabled>
        </Button>
        
        <StackPanel IsVisible="{Binding IsManualEntryVisible}" Spacing="10">
            <TextBlock Text="Or enter server address manually:" HorizontalAlignment="Center" FontSize="12"/>
            <TextBox Text="{Binding ManualAddress}" Watermark="https://192.168.1.x:7206" Width="300"/>
        </StackPanel>

        <TextBlock Text="Searching for servers..." 
                   IsVisible="{Binding !Servers.Count}"
                   HorizontalAlignment="Center"
                   FontStyle="Italic"/>
    </StackPanel>
</UserControl>
