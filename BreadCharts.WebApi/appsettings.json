{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=app.db;Cache=Shared"
  },
  "Spotify": {
    "ClientId": "YOUR_SPOTIFY_CLIENT_ID",
    "ClientSecret": "YOUR_SPOTIFY_CLIENT_SECRET"
  },
  "Jwt": {
    "Key": "SUPER_SECRET_KEY_PLEASE_CHANGE_IN_PRODUCTION",
    "Issuer": "BreadCharts.WebApi",
    "Audience": "BreadCharts.Apps"
  },
  "Voting": {
    "MaxVotesPerUser": 10
  },
  "Auth": {
    "RedirectUri": "https://127.0.0.1:7206/auth/callback"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
